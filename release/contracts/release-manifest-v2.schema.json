{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mc-remote:release-manifest:v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "release_tag", "source_commit", "artifacts"],
  "properties": {
    "schema": {
      "const": "mc-remote.release-manifest"
    },
    "schema_version": {
      "const": 2
    },
    "release_tag": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "bundled_wirescope_source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/ociArtifact"
          },
          {
            "$ref": "#/$defs/httpsFileArtifact"
          }
        ]
      }
    },
    "minecraft_compatibility": {
      "$ref": "#/$defs/minecraftCompatibility"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifacts": {
            "contains": {
              "properties": {
                "role": {
                  "const": "jar"
                }
              },
              "required": ["role"]
            }
          }
        },
        "required": ["artifacts"]
      },
      "then": {
        "required": ["minecraft_compatibility"]
      }
    }
  ],
  "$defs": {
    "ociArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "locator", "digest"],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "const": "oci"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "httpsFileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "kind", "file", "sha256", "bytes"],
      "properties": {
        "role": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "const": "https-file"
        },
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "os": {
          "enum": ["windows", "macos", "linux"]
        },
        "arch": {
          "enum": ["x64", "arm64"]
        },
        "artifact_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependentRequired": {
        "os": ["arch"],
        "arch": ["os"]
      }
    },
    "minecraftCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "verifications"],
      "properties": {
        "declaration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "minecraft_versions"],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "minecraft_versions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "verifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minecraft_version",
              "paper_build",
              "server_sha256",
              "java_version",
              "jar_sha256",
              "result",
              "record"
            ],
            "properties": {
              "minecraft_version": {
                "type": "string",
                "minLength": 1
              },
              "paper_build": {
                "type": "integer",
                "minimum": 1
              },
              "server_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "java_version": {
                "type": "string",
                "minLength": 1
              },
              "jar_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "result": {
                "const": "PASS"
              },
              "record": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "sha256"],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!\\.{1,2}$)(?![A-Za-z][A-Za-z0-9+.-]*:)[^/\\\\]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
